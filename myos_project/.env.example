SECRET_KEY=your-very-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

EMAIL_HOST_USER=yourname@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

REDIS_URL=redis://127.0.0.1:6379/1
OTP_EXPIRY_SECONDS=600

HCAPTCHA_SITEKEY=your-hcaptcha-sitekey
HCAPTCHA_SECRET=your-hcaptcha-secret

# SQLite is the zero-configuration option for local development.
DATABASE_ENGINE=sqlite
DATABASE_SQLITE_PATH=db_local.sqlite3

# For PostgreSQL, set DATABASE_ENGINE=postgres and provide your own values.
# DATABASE_NAME=myos
# DATABASE_USER=myos
# DATABASE_PASSWORD=replace-me
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432

SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
